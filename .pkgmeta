package-as: MateAuras

externals:
  MateAuras/Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  MateAuras/Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  MateAuras/Libs/AceTimer-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceTimer-3.0
  MateAuras/Libs/AceSerializer-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceSerializer-3.0
  MateAuras/Libs/AceComm-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceComm-3.0
  MateAuras/Libs/Chomp: https://github.com/wow-rp-addons/Chomp.git
  MateAuras/Libs/LibSharedMedia-3.0: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  MateAuras/Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  MateAuras/Libs/LibCompress: https://repos.curseforge.com/wow/libcompress/trunk
  MateAuras/Libs/LibDeflate: https://github.com/SafeteeWoW/LibDeflate
  MateAuras/Libs/LibSpellRange-1.0: https://github.com/ascott18/LibSpellRange-1.0
  MateAuras/Libs/LibRangeCheck-3.0: https://github.com/WeakAuras/LibRangeCheck-3.0/
  MateAuras/Libs/LibDBIcon-1.0: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  MateAuras/Libs/Archivist:
    url: https://github.com/emptyrivers/Archivist
    tag: v1.0.8
  MateAuras/Libs/LibSerialize:
    url: https://github.com/rossnichols/LibSerialize
    tag: v1.0.0
  MateAuras/Libs/LibSpecialization:
    url: https://github.com/BigWigsMods/LibSpecialization.git/LibSpecialization
  MateAuras/Libs/TaintLess:
    url: https://www.townlong-yak.com/addons.git/taintless
    commit: default
  MateAuras/Libs/LibAdvFlyable-1.1: https://github.com/Ghostopheles/LibAdvFlight
  MateAurasOptions/Libs/AceConfig-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceConfig-3.0
  MateAurasOptions/Libs/AceGUI-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceGUI-3.0
  MateAurasOptions/Libs/AceGUI-3.0-SharedMediaWidgets: https://repos.curseforge.com/wow/ace-gui-3-0-shared-media-widgets/trunk/AceGUI-3.0-SharedMediaWidgets
  MateAurasOptions/Libs/LibUIDropDownMenu: https://repos.wowace.com/wow/libuidropdownmenu/trunk/LibUIDropDownMenu
  MateAurasOptions/Libs/LibAPIAutoComplete-1.0: https://github.com/WeakAuras/LibAPIAutoComplete-1.0/

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - CONTRIBUTING.md
  - babelfish.lua
  - update_translations.sh
  - generate_changelog.sh
  - MateAuras/Libs/LibDeflate/docs
  - MateAuras/Libs/LibDeflate/examples
  - MateAuras/Libs/LibDeflate/*.md

plain-copy:
  - MateAurasModelPaths/*.lua

move-folders:
  MateAuras/MateAuras: MateAuras
  MateAuras/MateAurasOptions: MateAurasOptions
  MateAuras/MateAurasModelPaths: MateAurasModelPaths
  MateAuras/MateAurasTemplates: MateAurasTemplates
  MateAuras/MateAurasArchive: MateAurasArchive
  MateAuras/Libs/LibRangeCheck-3.0/LibRangeCheck-3.0: MateAuras/Libs/LibRangeCheck-3.0
  MateAurasOptions/Libs/LibAPIAutoComplete-1.0/LibAPIAutoComplete-1.0: MateAurasOptions/Libs/LibAPIAutoComplete-1.0
  MateAuras/WeakAuras: WeakAuras
  MateAuras/Mate2Auras: Mate2Auras
